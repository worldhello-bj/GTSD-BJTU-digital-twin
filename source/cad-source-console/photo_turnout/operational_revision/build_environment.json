{
  "schema": "gtsd-operational-build-environment-v1",
  "platform": "Debian GNU/Linux 13 (trixie)",
  "python": {
    "version": "3.12.14",
    "entry": "python"
  },
  "numpy": "2.3.5",
  "scipy": "1.17.0",
